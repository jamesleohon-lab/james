# Copy to .env and fill in. Never commit .env.

# Login passcode for the app. Leave empty only when running locally.
APP_PASSCODE=
# Random string used to sign the login cookie, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLite file. On Fly.io this lives on the mounted volume.
DATABASE_PATH=./data/crypto_macro.db

# Calendar feed. It's rate-limited: keep refreshes hours apart.
FF_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
FEED_REFRESH_HOURS=4
FEED_MIN_INTERVAL_MINUTES=60

SCHEDULER_ENABLED=1

# --- Phase 2 (push notifications); not used yet ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# BLS_API_KEY=     # https://data.bls.gov/registrationEngine/
# BEA_API_KEY=     # https://apps.bea.gov/API/signup/
